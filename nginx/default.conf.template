server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Health del contenedor (directo o vía Traefik Host mol-dev)
    location = /mol-health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    location = /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # Auth centralizada: inyecta X-API-Key (equivalente al proxy Vite en rematricula-online)
    location /api/auth {
        proxy_pass http://autenticacion-api:9502;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Content-Type $content_type;
        proxy_set_header X-API-Key "${REMATRICULA_API_KEY}";
        proxy_pass_request_headers on;
    }

    # uniacc-api (postulantes, matriculados, firma, rematrícula OTP, etc.)
    location /api/ {
        proxy_pass http://uniacc-api:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
