# =============================================================================
# mol-dev — variables para build (Vite) y runtime (nginx → auth)
# =============================================================================
#
# USO:
#   cp .env.docker.example .env
#   # o copiar desde /opt/rematricula-online/.env y ajustar
#   Editar valores reales (NUNCA commitear .env)
#
# IMPORTANTE:
# - VITE_* se inyectan en BUILD TIME (docker compose build).
# - REMATRICULA_API_KEY se inyecta en RUNTIME (nginx proxy /api/auth).
# - Con VITE_API_URL vacío, el browser llama /api/* al mismo origen
#   (mol-dev.uniacc.cl vía Traefik → nginx → autenticacion-api / uniacc-api).
#
# Acceso LAN sin DNS: en el cliente, /etc/hosts →
#   172.16.0.206  mol-dev.uniacc.cl
# Luego: http://mol-dev.uniacc.cl:9080/
#
# =============================================================================

# Supabase LOCAL (browser debe alcanzar esta URL; usar IP del host, no localhost del contenedor)
VITE_SUPABASE_URL=https://supabase-dev.uniacc.cl
VITE_SUPABASE_KEY=

# Mismo origen vía nginx/Traefik (recomendado en Docker)
VITE_API_URL=

# Auth (body origin/ambiente; la API key NO va al front)
VITE_AUTH_ORIGIN=1
VITE_AUTH_AMBIENTE=1
REMATRICULA_API_KEY=

# Solo server-side en Vite dev overlay (compose.dev); en prod nginx usa REMATRICULA_API_KEY
AUTH_API_URL=http://172.16.0.206:9080

# Periodo matrícula (opcional)
# VITE_MNP_MV_ANIO_MATRICULA=2026
# VITE_MNP_MV_PERIODO_MATRICULA=2

# Simulador (opcional)
VITE_SIMULADOR_SUPABASE_URL=
VITE_SIMULADOR_SUPABASE_ANON_KEY=

# VITE_DEBUG_BO_MENU=true
