# Periodo de matrícula legacy (fallback ETL si no hay tp_periodo_activo). Cabecera usa tp_periodo_activo.
# Debe coincidir con MNP_MV_* del ETL en integracion_umas.
# VITE_MNP_MV_ANIO_MATRICULA=2026
# VITE_MNP_MV_PERIODO_MATRICULA=2

# --- Supabase LOCAL (rematrícula: mv_usuario, admisión mv_*/gestorfirma_*, logs, etc.) ---
# Listados/stats postulantes, matriculados y firma consumen PostgREST desde el front (además de sync vía uniacc-api).
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_KEY=

# Logs detallados en consola del menú lateral (bo_menu_item / buildDashboardMenuPlan).
# En `npm run dev` ya están activos. En build de producción, pon `true` solo mientras depuras.
# VITE_DEBUG_BO_MENU=true

# --- Supabase SIMULADOR (proyecto aparte: prospectos, carreras_uniacc, becas_uniacc; pantalla «Uso simulador») ---
# Mismas variables que en Uniacc-dashboard-admision (VITE_SUPABASE_URL / ANON allí = este proyecto remoto).
VITE_SIMULADOR_SUPABASE_URL=
VITE_SIMULADOR_SUPABASE_ANON_KEY=

# --- API HTTP admisión (postulantes, matriculados, firma-acepta, OTP rematrícula; backend uniacc-api) ---
# Puertos alineados con operación típica (ver también Uniacc-dashboard-admision/ADMINISTRACION.md):
#   producción PM2 → backend :3001  |  desarrollo local de ese stack → backend :3002 y VITE_API_URL=http://localhost:3002
# rematricula-online en dev: con VITE_API_URL vacío, Vite proxy usa VITE_ADMISION_API_TARGET (p. ej. http://127.0.0.1:3002 si solo levantas API en dev).
# Tablas de admisión (mv_*, gestorfirma_*) en schema `public` del mismo Supabase local; DDL en supabase/migrations/20260421120000_uniacc_admision_public_schema.sql.
# Volcar datos: scripts/pg_dump_uniacc_admision_to_supabase.sh y variables SOURCE_PG_URI / TARGET_PG_URI.
# LAN / depuración: con URL absoluta el navegador llama directo a uniacc-api (sin proxy Vite). Útil si el proxy da timeout; CORS en la API debe incluir el origen del front (p. ej. :9501).
#   VITE_API_URL=http://172.16.0.206:3001
# Producción build estático: mismo patrón o nginx en el mismo origen.
# En HTTPS sin valor, el front llama /api al mismo origen (nginx debe proxy a uniacc-api).
VITE_API_URL=
# Desarrollo Vite: con `VITE_API_URL` vacío, el proxy reenvía /api/postulantes, /api/matriculados, /api/firma-acepta, /api/rematricula.
# Por defecto: http://127.0.0.1:3001 (uniacc-api). Si el front lo abres en otra máquina pero la API corre en el servidor LAN:
#   VITE_ADMISION_API_TARGET=http://172.16.0.206:3001
# Si queda en "Enviando…" y en Red ves encabezados provisionales, casi siempre el proxy no alcanza el host:puerto de uniacc-api.
VITE_ADMISION_API_TARGET=

# --- Autenticación centralizada (proxy Vite → autenticacion-uniacc-api-docker) ---
# Stack activo: /opt/ldap-autenticacion-docker + /opt/autenticacion-uniacc-api-docker
# AUTH_API_URL=http://localhost:9502
# Alternativa vía Traefik: AUTH_API_URL=http://172.16.0.206:9080
# REMATRICULA_API_KEY=<clave registrada en Supabase auth_api_clientes>
# VITE_AUTH_ORIGIN=1
# VITE_AUTH_AMBIENTE=1

# --- Autenticación LDAP (solo servidor de desarrollo Vite; NO uses prefijo VITE_) ---
# URL del servicio ldap-autenticacion (ver /opt/ldap-autenticacion/README.md)
LDAP_SERVICE_URL=http://localhost:3000
# Si el servicio LDAP tiene API_KEY en .env, copia el mismo valor aquí para que el proxy de Vite la envíe al validar.
# Nunca pongas esta clave en variables VITE_* ni en el frontend.
LDAP_API_KEY=

# --- API Pixarron (solo servidor; el proxy de Vite añade Basic Auth; NO uses prefijo VITE_) ---
PIXARRON_BASIC_USER=
PIXARRON_BASIC_PASS=

# Producción (build estático `npm run build`):
# El proxy de Vite no existe en `dist`. Configura el mismo path en tu reverse proxy:
#   location /api/auth/ldap {
#     proxy_pass http://tu-servicio-ldap:3000/validate;
#     proxy_set_header X-API-Key "tu_clave_si_aplica";
#     proxy_set_header Content-Type application/json;
#   }
#   # El front llama GET /api/pixarron/acceso/:usuario/:password → origen /api/acceso/:usuario/:password
#   location /api/pixarron/ {
#     rewrite ^/api/pixarron/acceso(.*)$ /api/acceso$1 break;
#     proxy_pass https://pixarron.uniacc.cl;
#     proxy_set_header Authorization "Basic <base64(usuario:clave_pixarron)>";
#   }
# O usa una Edge Function / backend que reenvíe a POST /validate con la API key en servidor.
