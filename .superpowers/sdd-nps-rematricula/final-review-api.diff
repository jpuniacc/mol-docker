+import { querySupabase } from '../config/postgres-supabase'
+
+export type NpsRematriculaFila = {
+  id: string
+  creadoEn: string
+  rut: string | null
+  codcli: string
+  codigoCarrera: string
+  jornada: string
+  calificacion: number
+  comentario: string | null
+}
+
+export type ListadoNpsRematricula = {
+  anio: number
+  semestre: number
+  totalRespuestas: number
+  totalFinalizados: number
+  filas: NpsRematriculaFila[]
+}
+
+type FilaPg = {
+  id: string
+  creado_en: Date | string
+  rut_alumno: string | null
+  codcli: string
+  codigo_carrera: string
+  jornada: string
+  calificacion: number
+  comentario: string | null
+}
+
+/** Comentarios del reporte: solo calificaciones 1–3 con texto. */
+export function filtrarComentariosBajos<T extends { calificacion: number; comentario: string | null }>(
+  filas: T[],
+): T[] {
+  return filas.filter((fila) => {
+    if (fila.calificacion < 1 || fila.calificacion > 3) return false
+    const texto = fila.comentario?.trim() ?? ''
+    return texto.length > 0
+  })
+}
+
+function mapFila(fila: FilaPg): NpsRematriculaFila {
+  return {
+    id: String(fila.id),
+    creadoEn: fila.creado_en instanceof Date ? fila.creado_en.toISOString() : String(fila.creado_en),
+    rut: fila.rut_alumno,
+    codcli: String(fila.codcli ?? ''),
+    codigoCarrera: String(fila.codigo_carrera ?? ''),
+    jornada: String(fila.jornada ?? ''),
+    calificacion: Number(fila.calificacion),
+    comentario: fila.comentario,
+  }
+}
+
+export async function listarNpsRematricula(anio: number, semestre: number): Promise<ListadoNpsRematricula> {
+  const [respuestas, finalizados] = await Promise.all([
+    querySupabase(
+      `SELECT id, creado_en, rut_alumno, codcli, codigo_carrera, jornada,
+              calificacion, comentario
+         FROM public.mnp_nps_rematricula
+        WHERE anio_periodo = $1 AND semestre_periodo = $2
+        ORDER BY creado_en DESC`,
+      [anio, semestre],
+    ),
+    querySupabase(
+      `SELECT count(*)::int AS n
+         FROM public.mnp_progreso_rematricula
+        WHERE anio_periodo = $1 AND semestre_periodo = $2
+          AND excluido_mol = false
+          AND sin_match_mol = false
+          AND etapa_actual IN ('firma', 'matriculado')`,
+      [anio, semestre],
+    ),
+  ])
+
+  const filas = ((respuestas.rows ?? []) as FilaPg[]).map(mapFila)
+  const totalFinalizados = Number((finalizados.rows?.[0] as { n?: number } | undefined)?.n ?? 0)
+
+  return {
+    anio,
+    semestre,
+    totalRespuestas: filas.length,
+    totalFinalizados,
+    filas,
+  }
+}
