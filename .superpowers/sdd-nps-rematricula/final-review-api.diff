+import { Request, Response } from 'express'
+
+import {
+  emailEjecutivoDeQuery,
+  rutEnCartera,
+  rutsDeEjecutivo,
+} from '../services/cartera-ejecutivo'
+import { listarNpsRematricula } from '../services/nps-rematricula.service'
+
+function enteroQuery(raw: unknown): number | null {
+  if (typeof raw === 'number' && Number.isInteger(raw)) return raw
+  if (typeof raw !== 'string') return null
+  const trimmed = raw.trim()
+  if (!/^\d+$/.test(trimmed)) return null
+  const n = Number(trimmed)
+  return Number.isInteger(n) ? n : null
+}
+
+/**
+ * GET /api/rematricula/nps?anio=&semestre=&emailEjecutivo=
+ */
+export async function listarNpsRematriculaHttp(req: Request, res: Response): Promise<void> {
+  const anio = enteroQuery(req.query.anio)
+  const semestre = enteroQuery(req.query.semestre)
+
+  if (anio == null || semestre == null) {
+    res.status(400).json({
+      ok: false,
+      message: 'Parámetros anio y semestre son obligatorios',
+    })
+    return
+  }
+
+  try {
+    const data = await listarNpsRematricula(anio, semestre)
+    const email = emailEjecutivoDeQuery(req.query.emailEjecutivo)
+    if (email) {
+      const ruts = await rutsDeEjecutivo(email)
+      data.filas = data.filas.filter((fila) => rutEnCartera(fila.rut, ruts))
+      data.totalRespuestas = data.filas.length
+    }
+    res.status(200).json({ ok: true, ...data })
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Error al listar NPS'
+    console.error('[nps-rematricula] listar:', message)
+    res.status(500).json({
+      ok: false,
+      message: 'No se pudieron leer las respuestas NPS',
+      error: message,
+    })
+  }
+}
